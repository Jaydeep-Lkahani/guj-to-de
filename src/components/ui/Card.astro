---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: extra = '' } = Astro.props;
const base = 'block rounded-2xl border border-line bg-surface p-5 shadow-soft';
const classes = href
  ? `${base} transition hover:-translate-y-0.5 hover:border-brand hover:shadow-lift ${extra}`
  : `${base} ${extra}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <div class={classes}>
    <slot />
  </div>
)}
