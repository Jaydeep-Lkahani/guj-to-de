---
interface Props {
  value: number; // 0–100
  label: string;
}

const { value, label } = Astro.props;
const pct = Math.max(0, Math.min(100, Math.round(value)));
---

<div
  role="progressbar"
  aria-label={label}
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow={pct}
  class="h-2.5 w-full overflow-hidden rounded-full bg-surface-2"
>
  <div class="h-full rounded-full bg-brand" style={`width: ${pct}%`}></div>
</div>
