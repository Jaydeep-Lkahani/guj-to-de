---
interface Props {
  variant?: 'info' | 'tip' | 'warn';
  title?: string;
}

const { variant = 'info', title } = Astro.props;

const styles = {
  info: 'border-brand bg-brand-soft',
  tip: 'border-ok bg-ok-soft',
  warn: 'border-warn bg-warn-soft',
};
---

<div class={`rounded-xl border-l-4 p-4 ${styles[variant]}`}>
  {title && <p class="mb-1 font-bold">{title}</p>}
  <div>
    <slot />
  </div>
</div>
