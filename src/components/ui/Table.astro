---
interface Props {
  headers: string[];
  rows: string[][];
  lang?: string; // set to "de" for tables of German text
}

const { headers, rows, lang } = Astro.props;
---

<div class="overflow-x-auto rounded-xl border border-line shadow-soft">
  <table class="w-full border-collapse text-left" lang={lang}>
    <thead class="bg-brand-soft text-brand">
      <tr>
        {headers.map((h) => (
          <th class="px-3 py-2.5 font-bold">{h}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class="border-t border-line">
          {row.map((cell) => (
            <td class="px-3 py-2">{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
