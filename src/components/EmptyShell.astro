---
import { t } from '../lib/t';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<h1 class="page-title mb-5">{title}</h1>
<slot />
<div class="card flex items-center gap-4 border-dashed p-6">
  <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-accent-soft text-accent-text">
    <svg
      viewBox="0 0 24 24"
      width="24"
      height="24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"></path>
    </svg>
  </span>
  <p class="font-semibold">{t('pages.comingSoon')}</p>
</div>
