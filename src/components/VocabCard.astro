---
import type { VocabItem } from '../content/schemas';
import { t } from '../lib/t';
import AudioButton from './AudioButton.tsx';

interface Props {
  item: VocabItem;
}

const { item } = Astro.props;

const articleStyle = {
  der: 'bg-der-soft text-der',
  die: 'bg-die-soft text-die',
  das: 'bg-das-soft text-das',
};
---

<div class="rounded-xl border border-line bg-surface p-4">
  <div class="flex items-start justify-between gap-3">
    <p class="flex flex-wrap items-baseline gap-x-2 text-xl font-bold" lang="de">
      {item.gender && (
        <span class={`rounded px-1.5 text-base ${articleStyle[item.gender]}`}>{item.gender}</span>
      )}
      <span>{item.de}</span>
      {item.plural && (
        <span class="text-sm font-normal text-muted">
          <span lang="gu">{t('lesson.plural')}:</span> {item.plural}
        </span>
      )}
    </p>
    <AudioButton client:visible text={item.gender ? `${item.gender} ${item.de}` : item.de} />
  </div>
  <p class="mt-1 text-lg">
    {item.gu}
    {item.pron_gu && <span class="pron-helper ml-2 text-sm text-muted">({item.pron_gu})</span>}
  </p>
  <p class="mt-2 text-sm" lang="de">
    {item.example_de}
  </p>
  <p class="text-sm text-muted">{item.example_gu}</p>
</div>
