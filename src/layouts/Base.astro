---
import '@fontsource-variable/inter';
import '@fontsource/noto-sans-gujarati/400.css';
import '@fontsource/noto-sans-gujarati/600.css';
import '@fontsource/noto-sans-gujarati/700.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { t } from '../lib/t';

interface Props {
  title: string;
}

const { title } = Astro.props;
const fullTitle = title === t('app.title') ? title : `${title} · ${t('app.title')}`;
---

<!doctype html>
<html lang="gu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <script is:inline>
      // Apply a saved theme before first paint to avoid a flash
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {
        // storage unavailable: fall back to the OS theme
      }
      try {
        // pronunciation helper setting lives in the saved progress (see src/lib/progress-store.ts)
        const progress = JSON.parse(localStorage.getItem('guj-de:progress') || 'null');
        if (progress && progress.settings && progress.settings.pronHelper === false) {
          document.documentElement.dataset.pron = 'off';
        }
      } catch {
        // no saved settings: helper stays on
      }
    </script>
  </head>
  <body class="min-h-dvh bg-bg text-fg">
    <div class="md:flex">
      <Nav />
      <div class="min-w-0 flex-1">
        <header class="sticky top-0 z-10 flex h-14 items-center justify-between border-b border-line bg-surface px-4 md:hidden">
          <a href="/" class="text-lg font-bold">
            {t('app.title')}
          </a>
          <ThemeToggle />
        </header>
        <div class="hidden justify-end px-4 pt-3 md:flex">
          <ThemeToggle />
        </div>
        <main class="mx-auto max-w-3xl px-4 pt-6 pb-24 md:pb-10">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
