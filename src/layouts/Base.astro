---
import '@fontsource-variable/inter';
import '@fontsource/noto-sans-gujarati/400.css';
import '@fontsource/noto-sans-gujarati/600.css';
import '@fontsource/noto-sans-gujarati/700.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { t } from '../lib/t';

interface Props {
  title: string;
}

const { title } = Astro.props;
const fullTitle = title === t('app.title') ? title : `${title} · ${t('app.title')}`;
---

<!doctype html>
<html lang="gu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={t('app.tagline')} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={t('app.title')} />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0a1d" media="(prefers-color-scheme: dark)" />
    {import.meta.env.PROD && <script is:inline>
      // Offline copy of the site (scripts/pwa.mjs writes /sw.js at build time)
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
      }
    </script>}
    <script is:inline>
      // Apply a saved theme before first paint to avoid a flash
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {
        // storage unavailable: fall back to the OS theme
      }
      try {
        // pronunciation helper setting lives in the saved progress (see src/lib/progress-store.ts)
        const progress = JSON.parse(localStorage.getItem('guj-de:progress') || 'null');
        if (progress && progress.settings && progress.settings.pronHelper === false) {
          document.documentElement.dataset.pron = 'off';
        }
      } catch {
        // no saved settings: helper stays on
      }
    </script>
  </head>
  <body class="min-h-dvh bg-bg text-fg">
    <div class="md:flex">
      <Nav />
      <div class="min-w-0 flex-1">
        <header class="sticky top-0 z-10 flex h-14 items-center justify-between border-b border-line bg-surface/85 px-4 backdrop-blur-md md:hidden">
          <a href="/" class="flex items-center gap-2 text-lg font-extrabold">
            <span
              class="grid size-8 place-items-center rounded-lg bg-gradient-to-br from-brand to-[#7a4be0] text-sm font-extrabold text-white"
              lang="de"
              aria-hidden="true"
            >
              D
            </span>
            {t('app.title')}
          </a>
          <ThemeToggle />
        </header>
        <div class="hidden justify-end px-6 pt-4 md:flex">
          <ThemeToggle />
        </div>
        <main class="mx-auto max-w-4xl px-4 pt-6 pb-28 md:px-8 md:pb-14">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
