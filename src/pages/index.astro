---
import Base from '../layouts/Base.astro';
import Dashboard from '../components/Dashboard.tsx';
import Icon from '../components/Icon.astro';
import { getCatalog } from '../lib/catalog';
import { secondaryNav } from '../lib/nav';
import { t } from '../lib/t';

const catalog = await getCatalog();
---

<Base title={t('app.title')}>
  <h1 class="sr-only">
    {t('app.title')} · {t('app.tagline')}
  </h1>

  <Dashboard client:load catalog={catalog} />

  <h2 class="mt-10 mb-3 text-lg font-extrabold">{t('home.explore')}</h2>
  <ul class="grid grid-cols-2 gap-3 lg:grid-cols-3">
    {secondaryNav.map((item) => (
      <li>
        <a
          href={item.href}
          class="group flex h-full items-center gap-3 rounded-2xl border border-line bg-surface p-4 shadow-soft transition hover:-translate-y-0.5 hover:border-brand hover:shadow-lift"
        >
          <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-brand-soft text-brand transition group-hover:bg-brand group-hover:text-brand-fg">
            <Icon name={item.icon} />
          </span>
          <span class="font-semibold">{t(item.key)}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
