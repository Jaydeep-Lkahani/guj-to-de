---
import Base from '../layouts/Base.astro';
import Card from '../components/ui/Card.astro';
import Dashboard from '../components/Dashboard.tsx';
import { getCatalog } from '../lib/catalog';
import { secondaryNav } from '../lib/nav';
import { t } from '../lib/t';

const catalog = await getCatalog();
---

<Base title={t('app.title')}>
  <h1 class="text-2xl font-bold">{t('pages.home')}</h1>
  <p class="mt-2 mb-6 text-muted">{t('app.tagline')}</p>

  <Dashboard client:load catalog={catalog} />

  <h2 class="mt-8 mb-3 text-lg font-semibold">{t('nav.more')}</h2>
  <ul class="grid gap-3 sm:grid-cols-2">
    {secondaryNav.map((item) => (
      <li>
        <Card href={item.href}>{t(item.key)}</Card>
      </li>
    ))}
  </ul>
</Base>
