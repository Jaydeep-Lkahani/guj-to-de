---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import EmptyShell from '../../../components/EmptyShell.astro';
import ChapterLessons from '../../../components/ChapterLessons.tsx';
import Button from '../../../components/ui/Button.astro';
import LevelBadge from '../../../components/ui/LevelBadge.astro';
import { chapterNumber, chapterNumbers, chapterSlug, levelOf } from '../../../lib/chapters';
import { t } from '../../../lib/t';

export async function getStaticPaths() {
  const metas = await getCollection('chapters');
  const lessons = await getCollection('lessons');
  const tests = await getCollection('chapterTests');
  return chapterNumbers.map((n) => {
    const slug = chapterSlug(n);
    return {
      params: { ch: slug },
      props: {
        meta: metas.find((m) => m.id === `${slug}/meta`)?.data,
        lessonList: lessons
          .filter((l) => l.id.startsWith(`${slug}/`))
          .map((l) => l.data)
          .sort((a, b) => a.number - b.number),
        hasTest: tests.some((x) => x.id === `${slug}/test`),
      },
    };
  });
}

const { ch } = Astro.params;
const { meta, lessonList, hasTest } = Astro.props;
const n = chapterNumber(ch);
const title = `${t('words.chapter')} ${n}`;
---

<Base title={meta ? `${meta.title_gu} · ${title}` : title}>
  <div>
    {meta ? (
      <>
        <p class="mb-1 flex items-center gap-2 text-sm font-bold text-brand">
          {title} <LevelBadge level={levelOf(n)} />
        </p>
        <h1 class="page-title mb-2">{meta.title_gu}</h1>
        <p class="mb-6 text-muted">{meta.description_gu}</p>

        <h2 class="section-title">{t('lesson.canDo')}</h2>
        <ul class="card mb-8 grid gap-2 p-4">
          {meta.can_do_gu.map((item) => (
            <li class="flex gap-2">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <h2 class="section-title">{t('lesson.lessons')}</h2>
        <div class="mb-6">
          <ChapterLessons
            client:load
            lessons={lessonList.map((l) => ({
              id: l.id,
              number: l.number,
              title: l.title_gu,
              href: `/chapters/${ch}/${l.id.slice(5)}/`,
            }))}
          />
        </div>

        {hasTest && (
          <Button href={`/chapters/${ch}/test/`} variant="secondary">
            {t('words.chapterTest')}
          </Button>
        )}
      </>
    ) : (
      <EmptyShell title={title}>
        <p class="mb-4">
          <LevelBadge level={levelOf(n)} />
        </p>
      </EmptyShell>
    )}
  </div>
</Base>
