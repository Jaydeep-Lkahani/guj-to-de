---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Button from '../../../components/ui/Button.astro';
import Callout from '../../../components/ui/Callout.astro';
import Table from '../../../components/ui/Table.astro';
import VocabCard from '../../../components/VocabCard.astro';
import Dialogue from '../../../components/Dialogue.tsx';
import LessonComplete from '../../../components/LessonComplete.tsx';
import LessonPractice from '../../../components/LessonPractice.tsx';
import StudyTimer from '../../../components/StudyTimer.tsx';
import AudioButton from '../../../components/AudioButton.tsx';
import AudioControls from '../../../components/AudioControls.tsx';
import Recorder from '../../../components/Recorder.tsx';
import ShadowingList from '../../../components/ShadowingList.tsx';
import { chapterNumber } from '../../../lib/chapters';
import { renderMarkdown } from '../../../lib/markdown';
import { t } from '../../../lib/t';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  const metas = await getCollection('chapters');
  return lessons.map((entry) => {
    const [ch, , lesson] = entry.id.split('/'); // "ch01/lessons/l01"
    const order = metas.find((m) => m.id === `${ch}/meta`)?.data.lessons ?? [];
    const at = order.indexOf(entry.data.id);
    return {
      params: { ch, lesson },
      props: {
        data: entry.data,
        prevId: at > 0 ? order[at - 1] : undefined,
        nextId: at >= 0 ? order[at + 1] : undefined,
      },
    };
  });
}

const { ch } = Astro.params;
const { data, prevId, nextId } = Astro.props;
const heading = `${t('words.chapter')} ${chapterNumber(ch)} · ${t('words.lesson')} ${data.number}`;
const lessonHref = (id: string) => `/chapters/${ch}/${id.slice(5)}/`;
---

<Base title={`${data.title_gu} · ${heading}`}>
  <StudyTimer client:load />
  <div>
    <p class="mb-1 text-sm text-muted">
      <a href={`/chapters/${ch}/`} class="hover:underline">
        ← {t('lesson.backToChapter')}
      </a>
    </p>
    <p class="text-sm font-bold text-brand">{heading}</p>
    <h1 class="mb-4 text-3xl leading-snug font-extrabold tracking-tight">{data.title_gu}</h1>
    <div class="mb-6">
      <AudioControls client:load />
    </div>

    <div class="flex flex-col gap-8">
      <section>
        <Callout title={t('lesson.goal')}>{data.goal_gu}</Callout>
      </section>

      {data.vocab.length > 0 && (
        <section>
          <h2 class="section-title">{t('words.vocabulary')}</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {data.vocab.map((item) => (
              <li>
                <VocabCard item={item} />
              </li>
            ))}
          </ul>
        </section>
      )}

      {data.grammar.length > 0 && (
        <section>
          <h2 class="section-title">{t('words.grammar')}</h2>
          <div class="flex flex-col gap-6">
            {data.grammar.map((block) => (
              <div class="flex flex-col gap-3">
                <h3 class="text-lg font-semibold">{block.title_gu}</h3>
                <div class="md" set:html={renderMarkdown(block.explanation_gu)} />
                {block.tables?.map((table) => (
                  <Table headers={table.headers} rows={table.rows} />
                ))}
                <ul class="grid gap-2">
                  {block.examples.map((ex) => (
                    <li class="flex items-center gap-3 rounded-xl bg-surface-2 p-3">
                      <AudioButton client:visible text={ex.de} />
                      <div>
                        <p lang="de" class="font-semibold">
                          {ex.de}
                        </p>
                        <p class="text-muted">{ex.gu}</p>
                        {ex.note_gu && <p class="text-sm text-muted">{ex.note_gu}</p>}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )}

      {data.dialogue && (
        <section>
          <h2 class="section-title">{t('words.dialogue')}</h2>
          <Dialogue client:load lines={data.dialogue.lines} />
        </section>
      )}

      <section>
        <h2 class="section-title">{t('words.practice')}</h2>
        <LessonPractice
          client:only="react"
          lessonId={data.id}
          lessonTitle={data.title_gu}
          exercises={data.exercises}
        />
      </section>

      <section>
        <h2 class="section-title">{t('lesson.speaking')}</h2>
        <p class="mb-2 text-sm text-muted">{t('lesson.shadowing')}</p>
        <ShadowingList client:visible lines={data.speaking.shadowing} />
        <p class="mt-4 font-semibold">{t('lesson.freeSpeaking')}</p>
        <p class="mb-3">{data.speaking.prompt_gu}</p>
        <Recorder client:visible />
      </section>

      <section>
        <h2 class="section-title">{t('lesson.writing')}</h2>
        <p>{data.writing.task_gu}</p>
        <details class="mt-3 rounded-xl border border-line bg-surface p-3 shadow-soft">
          <summary class="cursor-pointer font-semibold">{t('lesson.modelAnswer')}</summary>
          <p lang="de" class="mt-2 text-lg">
            {data.writing.model_answer_de}
          </p>
        </details>
        <p class="mt-4 font-semibold">{t('lesson.checklist')}</p>
        <ul class="mt-2 grid gap-2">
          {data.writing.checklist_gu.map((item) => (
            <li>
              <label class="flex min-h-11 items-center gap-3">
                <input type="checkbox" class="size-5 accent-[var(--brand)]" />
                <span>{item}</span>
              </label>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="section-title">{t('lesson.summary')}</h2>
        <ul class="list-disc space-y-1 pl-5">
          {data.summary_gu.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>

      <div>
        <LessonComplete client:load lessonId={data.id} />
      </div>

      <nav class="flex justify-between gap-3">
        {prevId ? (
          <Button href={lessonHref(prevId)} variant="secondary">
            ← {t('words.back')}
          </Button>
        ) : (
          <span />
        )}
        {nextId ? (
          <Button href={lessonHref(nextId)}>{t('words.next')} →</Button>
        ) : (
          <Button href={`/chapters/${ch}/`}>{t('lesson.backToChapter')}</Button>
        )}
      </nav>
    </div>
  </div>
</Base>
