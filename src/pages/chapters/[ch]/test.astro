---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import EmptyShell from '../../../components/EmptyShell.astro';
import ExerciseRunner from '../../../components/ExerciseRunner.tsx';
import AudioControls from '../../../components/AudioControls.tsx';
import { chapterNumber, chapterNumbers, chapterSlug } from '../../../lib/chapters';
import { t } from '../../../lib/t';

export async function getStaticPaths() {
  const tests = await getCollection('chapterTests');
  return chapterNumbers.map((n) => {
    const slug = chapterSlug(n);
    return {
      params: { ch: slug },
      props: { test: tests.find((x) => x.id === `${slug}/test`)?.data },
    };
  });
}

const { test } = Astro.props;
const n = chapterNumber(Astro.params.ch);
const title = `${t('words.chapter')} ${n} · ${t('words.chapterTest')}`;
---

<Base title={title}>
  {test ? (
    <>
      <h1 class="mb-4 text-2xl font-bold">{title}</h1>
      <div class="mb-6">
        <AudioControls client:load />
      </div>
      <ExerciseRunner client:only="react" exercises={test.exercises} />
    </>
  ) : (
    <EmptyShell title={title} />
  )}
</Base>
