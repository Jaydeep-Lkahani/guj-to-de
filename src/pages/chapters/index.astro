---
import Base from '../../layouts/Base.astro';
import ChaptersList from '../../components/ChaptersList.tsx';
import { getCatalog } from '../../lib/catalog';
import { t } from '../../lib/t';

const catalog = await getCatalog();
---

<Base title={t('nav.chapters')}>
  <h1 class="mb-4 text-2xl font-bold">{t('nav.chapters')}</h1>
  <ChaptersList client:load catalog={catalog} />
</Base>
