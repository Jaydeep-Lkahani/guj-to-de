---
import Base from '../../layouts/Base.astro';
import ChaptersList from '../../components/ChaptersList.tsx';
import { getCatalog } from '../../lib/catalog';
import { t } from '../../lib/t';

const catalog = await getCatalog();
---

<Base title={t('nav.chapters')}>
  <h1 class="page-title">{t('nav.chapters')}</h1>
  <p class="mt-1 mb-6 text-muted">{t('home.tagline')}</p>
  <ChaptersList client:load catalog={catalog} />
</Base>
