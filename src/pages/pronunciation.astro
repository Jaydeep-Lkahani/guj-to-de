---
import Base from '../layouts/Base.astro';
import Callout from '../components/ui/Callout.astro';
import AudioButton from '../components/AudioButton.tsx';
import AudioControls from '../components/AudioControls.tsx';
import ExerciseRunner from '../components/ExerciseRunner.tsx';
import ShadowingList from '../components/ShadowingList.tsx';
import StudyTimer from '../components/StudyTimer.tsx';
import { soundsSchema } from '../content/schemas';
import rawSounds from '../content-shared/sounds.json';
import { t } from '../lib/t';

const { groups, quiz } = soundsSchema.parse(rawSounds);
---

<Base title={t('nav.pronunciation')}>
  <h1 class="page-title mb-3">{t('nav.pronunciation')}</h1>
  <StudyTimer client:load />
  <p class="mb-4 max-w-prose text-muted">{t('pron.intro')}</p>
  <div class="mb-4">
    <AudioControls client:load />
  </div>
  <Callout variant="tip">{t('pron.audioFirst')}</Callout>

  <nav aria-label={t('pron.jumpTo')} class="my-5 flex flex-wrap gap-2">
    {groups.map((group) => (
      <a
        href={`#${group.id}`}
        class="rounded-full border border-line bg-surface px-4 py-2 text-sm font-semibold hover:border-brand hover:bg-brand-soft"
      >
        {group.title_gu}
      </a>
    ))}
    <a
      href="#quiz"
      class="rounded-full border border-line bg-surface px-4 py-2 text-sm font-semibold hover:border-brand hover:bg-brand-soft"
    >
      {t('pron.quizTitle')}
    </a>
  </nav>

  <div class="flex flex-col gap-10">
    {groups.map((group) => (
      <section id={group.id} class="scroll-mt-20">
        <h2 class="section-title">{group.title_gu}</h2>
        <p class="mb-4 text-muted">{group.intro_gu}</p>
        <ul class="grid gap-4 lg:grid-cols-2">
          {group.sounds.map((sound) => (
            <li class="card flex flex-col gap-3 p-4">
              <div class="flex flex-wrap items-center gap-3">
                <span
                  lang="de"
                  class="rounded-xl bg-brand-soft px-3 py-1 text-2xl font-extrabold text-brand"
                >
                  {sound.letters}
                </span>
                <span class="text-xl font-bold">{sound.helper_gu}</span>
                {sound.approx && (
                  <span class="rounded-full bg-warn-soft px-2 py-0.5 text-xs font-bold">
                    {t('pron.approxBadge')}
                  </span>
                )}
              </div>
              <p>{sound.tip_gu}</p>
              {sound.approx && <p class="text-sm text-muted">{t('pron.approxNote')}</p>}
              <ul class="grid gap-2">
                {sound.examples.map((example) => (
                  <li class="flex items-center gap-3 rounded-xl bg-surface-2 p-2 pr-3">
                    <AudioButton client:visible text={example.de} />
                    <div class="min-w-0">
                      <p class="flex flex-wrap items-baseline gap-x-2">
                        <span lang="de" class="text-lg font-semibold">
                          {example.de}
                        </span>
                        <span class="text-sm text-muted">({example.pron_gu})</span>
                      </p>
                      <p class="text-sm text-muted">{example.gu}</p>
                    </div>
                  </li>
                ))}
              </ul>
              <details class="rounded-xl border border-line bg-surface p-3">
                <summary class="cursor-pointer font-semibold">{t('pron.practice')}</summary>
                <div class="mt-3">
                  <ShadowingList client:visible lines={sound.examples.map((e) => e.de)} />
                </div>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section id="quiz" class="scroll-mt-20">
      <h2 class="section-title">{t('pron.quizTitle')}</h2>
      <p class="mb-4 text-muted">{t('pron.quizIntro')}</p>
      <ExerciseRunner client:only="react" exercises={quiz} fallbackTopic={t('nav.pronunciation')} />
    </section>
  </div>
</Base>
